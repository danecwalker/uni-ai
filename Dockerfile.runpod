# syntax=docker/dockerfile:1.6
# RunPod-targeted image: CUDA base + GPU builds of torch / onnxruntime so
# InsightFace, FER+, and Kokoro run on the GPU. Pair with a RunPod GPU pod
# (e.g. RTX A4000 / 4090) and expose port 8000.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3-pip \
        build-essential cmake \
        libgl1 libglib2.0-0 \
        espeak-ng \
        curl ca-certificates \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install GPU torch first (CUDA 12.1 wheels) so the requirements.txt CPU
# --extra-index-url line doesn't downgrade us.
RUN pip install --upgrade pip && \
    pip install --index-url https://download.pytorch.org/whl/cu121 \
        torch>=2.2.0

# App deps. Strip the CPU torch index line + torch pin from requirements so
# pip keeps the CUDA build above.
COPY requirements.txt ./
RUN grep -vE '^(--extra-index-url https://download\.pytorch\.org/whl/cpu|torch)\b' requirements.txt > /tmp/req.txt && \
    pip install -r /tmp/req.txt && \
    pip install onnxruntime-gpu

# Bake the small FER+ emotion ONNX into the image.
RUN mkdir -p /app/baked_models && \
    curl -fsSL -o /app/baked_models/emotion-ferplus-8.onnx \
      https://github.com/onnx/models/raw/main/validated/vision/body_analysis/emotion_ferplus/model/emotion-ferplus-8.onnx
ENV EMOTION_MODEL_PATH=/app/baked_models/emotion-ferplus-8.onnx

COPY companion_ai/ ./companion_ai/
COPY web/ ./web/

RUN mkdir -p /app/models

EXPOSE 8000
CMD ["uvicorn", "web.app:app", "--host", "0.0.0.0", "--port", "8000"]
