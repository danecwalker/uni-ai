# ─── Required ───────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ─── Models ─────────────────────────────────────────────────────────────────
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Path to the FER+ emotion ONNX. The Docker image bakes it at
# /app/baked_models/emotion-ferplus-8.onnx and sets this var automatically —
# only override in bare-metal dev runs.
# EMOTION_MODEL_PATH=models/emotion-ferplus-8.onnx

# ─── Idle emotion-trigger tuning ────────────────────────────────────────────
# Lower thresholds = more eager auto check-ins.
EMOTION_SIGNAL_WINDOW=8
EMOTION_SIGNAL_MIN_NON_NEUTRAL=2
EMOTION_SIGNAL_MIN_AVG_CONFIDENCE=0.12
EMOTION_SIGNAL_SPIKE_CONFIDENCE=0.28
EMOTION_SIGNAL_SPIKE_FRAMES=1
IDLE_DECISION_COOLDOWN_SECONDS=4

# ─── Compose-level (optional) ───────────────────────────────────────────────
# IMAGE=ghcr.io/<owner>/<repo>:latest   # pull a remote image instead of building
# PORT=8000                              # host port for the UI
